# davai — environment configuration
#
# Copy to $DAVAI_HOME/.env (~/.davai/.env) and edit. All values are optional;
# commented-out lines show defaults. The real environment overrides this file,
# and CLI flags override the environment.

# ── Core ──────────────────────────────────────────────────────────────

# Provider and model. Valid providers: anthropic, openai, gemini, grok,
# openrouter. Default provider: anthropic. Default model depends on the
# provider (see src/config/models.js).
#DAVAI_PROVIDER=anthropic
#DAVAI_MODEL=claude-opus-5

# Effort/reasoning level. Valid: low, medium, high, xhigh, max. Mapped per
# provider; unsupported levels are coerced.
#DAVAI_EFFORT=high

# Max output tokens per turn. Clamped to the model's real max output.
#DAVAI_MAX_TOKENS=32000

# Override the model's context window, in tokens.
#DAVAI_CONTEXT_LIMIT=

# Auto-compact threshold: fraction of the context window at which compaction
# fires. Must be strictly between 0 and 1.
#DAVAI_COMPACT_AT=0.75

# Session budget cap in dollars. The run stops when cumulative spend reaches
# this. 0 disables the cap.
#DAVAI_MAX_COST=0

# Additional directories the agent may read (in addition to the working
# directory). Path-list separated by ':' on POSIX, ';' on Windows.
#DAVAI_RO_DIRS=/etc,/var/log

# Sampling temperature. Provider-dependent; omit for the provider default.
#DAVAI_TEMPERATURE=

# Shell command timeout, in seconds.
#DAVAI_SHELL_TIMEOUT=120

# How long a sudo password stays cached, in seconds.
#DAVAI_SUDO_TTL=900

# Stream the model's reasoning in a panel above the answer.
#DAVAI_THINKING=false

# Treat an emitted event with no listener as an error instead of a warning.
#DAVAI_STRICT_EVENTS=false

# Auto-approve shell commands for this run. Prefer the /yolo toggle inside a
# session; this env var applies to every run until unset. Never persisted to
# settings.json.
#DAVAI_YOLO=false

# ── Web sidecar ────────────────────────────────────────────────────────

# Serve the session over HTTP alongside the REPL (same as --web).
#DAVAI_WEB=false
#DAVAI_WEB_PORT=7878
#DAVAI_WEB_HOST=127.0.0.1
# Fixed token for the sidecar. Omit for a fresh token minted per run and
# printed (and copied to the clipboard) on launch.
#DAVAI_WEB_TOKEN=

# ── Provider keys ──────────────────────────────────────────────────────
# Use the generic names, or the DAVAI_-prefixed equivalents. The prefixed
# variants win if both are set.

# Anthropic
#ANTHROPIC_API_KEY=
#DAVAI_ANTHROPIC_API_KEY=

# OpenAI
#OPENAI_API_KEY=
#DAVAI_OPENAI_API_KEY=

# Gemini
#GEMINI_API_KEY=
#DAVAI_GEMINI_API_KEY=
#GOOGLE_API_KEY=

# Grok (xAI)
#XAI_API_KEY=
#DAVAI_GROK_API_KEY=

# OpenRouter
#OPENROUTER_API_KEY=
#DAVAI_OPENROUTER_API_KEY=

# ── Provider tuning ────────────────────────────────────────────────────

# OpenAI API surface: "responses" (default; streams reasoning summaries) or
# "chat" (Chat Completions; no reasoning summaries).
#DAVAI_OPENAI_SURFACE=responses
# Legacy alias for the above.
#DAVAI_OPENAI_API=

# Custom base URL for OpenAI-compatible providers (OpenAI, Grok, OpenRouter)
# or a proxy for any provider.
#DAVAI_BASE_URL=

# ── Advanced ───────────────────────────────────────────────────────────

# Location of sessions, history and settings (default ~/.davai). Read at
# bootstrap; cannot be set inside $DAVAI_HOME/.env itself.
#DAVAI_HOME=
