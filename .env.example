# davai configuration
#
# Copy to $DAVAI_HOME/.env (default: ~/.davai/.env) so davai works from any
# directory. A ./.env in the project you are working in is also read, and
# overrides the home one; real environment variables override both.

# --- provider ---------------------------------------------------------------
# anthropic | openai | gemini | grok
DAVAI_PROVIDER=anthropic

# Leave unset to use the provider default. `davai --models` lists what the
# provider actually serves — that is the authority, not davai's built-in list.
#DAVAI_MODEL=claude-opus-5-5

# --- credentials ------------------------------------------------------------
ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#XAI_API_KEY=

# --- access ------------------------------------------------------------------
# Directories the agent may READ but never write, in PATH form
# (';' separated on Windows, ':' elsewhere). Writes are always confined to the
# working directory and its subdirectories.
#DAVAI_RO_DIRS=C:\refs\specs;C:\refs\vendor-docs

# --- behaviour ---------------------------------------------------------------
# low | medium | high | xhigh | max
DAVAI_EFFORT=high

# Max tokens per response. Defaults to min(model max output, 32000).
#DAVAI_MAX_TOKENS=32000

# Sampling temperature. Unset means the provider default; current reasoning
# models reject it entirely, so leave it alone unless you know you need it.
#DAVAI_TEMPERATURE=

# Seconds before a shell op is killed.
DAVAI_SHELL_TIMEOUT=120

# Fraction of the context window at which auto-compaction kicks in.
DAVAI_COMPACT_AT=0.75

# Override the context window. Normally detected from the model.
#DAVAI_CONTEXT_LIMIT=

# Show the model's reasoning summary while it streams. Claude and OpenAI stream real
# summaries; Gemini needs this to return thought parts at all; Grok has nothing to show
# on grok-4. The models think either way — this only decides whether you see it.
DAVAI_THINKING=false

# Which OpenAI API to use. `responses` is the default and the only one that can return
# reasoning summaries; `chat` is Chat Completions, for an endpoint that lacks
# /v1/responses. Grok always uses Chat Completions regardless.
#DAVAI_OPENAI_API=responses

# Run shell commands without asking for approval. Off unless you mean it: the write
# jail and read allowlist still hold, but nothing pauses before `rm -rf` either.
# `--yolo` does this for one run, `/yolo` toggles it inside a session.
DAVAI_YOLO=false

# --- development -------------------------------------------------------------
# Turn a half-wired event into a thrown error. Every event the harness emits is meant to
# be consumed by the TUI and, where it makes sense, by headless mode; an emit with no
# listener is silent by default, which is how several shipped. Off unless you are working
# on the harness — /events counts them either way, and the exit line names them.
#DAVAI_STRICT_EVENTS=false

# --- history -----------------------------------------------------------------
# Prompts are recorded to $DAVAI_HOME/history.jsonl and reachable with the up arrow,
# /history and /replay <n>. Slash commands and `sh` lines are not recorded. Delete the
# file to clear it.

# --- prompts -----------------------------------------------------------------
# Every prompt davai sends can be replaced. Each takes an inline value, or a path in
# the matching _FILE variable — easier for anything multi-line. Inline wins if both
# are set. An override that is empty, or that drops its {placeholder}, is an error at
# startup rather than a silent behaviour change.
#
#   DAVAI_PROMPT_PREAMBLE      who the assistant is and how it should write
#   DAVAI_PROMPT_PROTOCOL      the whole da_ops specification
#   DAVAI_PROMPT_OPS_RESULT    wraps each result batch; must contain {results}
#   DAVAI_PROMPT_NUDGE         sent when a turn produced no ops and no conclusion
#   DAVAI_PROMPT_STEER         wraps a mid-run correction; must contain {text}
#   DAVAI_PROMPT_REPAIR        sent when a da_ops block did not parse; needs {error}
#
# Replacing DAVAI_PROMPT_PROTOCOL replaces the contract the parser implements, so the
# model can stop producing anything davai can execute. Start from the default text.
#DAVAI_PROMPT_PREAMBLE_FILE=~/.davai/preamble.md
#DAVAI_PROMPT_OPS_RESULT=Results of your batch:\n\n{results}

# --- network -----------------------------------------------------------------
#HTTP_PROXY=
#HTTPS_PROXY=
#NO_PROXY=
