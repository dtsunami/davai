# davai configuration
#
# Copy to $DAVAI_HOME/.env (default: ~/.davai/.env) so davai works from any
# directory. A ./.env in the project you are working in is also read, and
# overrides the home one; real environment variables override both.

# --- provider ---------------------------------------------------------------
# anthropic | openai | gemini | grok
DAVAI_PROVIDER=anthropic

# Leave unset to use the provider default. `davai --models` lists what the
# provider actually serves — that is the authority, not davai's built-in list.
#DAVAI_MODEL=claude-opus-5-5

# --- credentials ------------------------------------------------------------
ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#XAI_API_KEY=

# --- access ------------------------------------------------------------------
# Directories the agent may READ but never write, in PATH form
# (';' separated on Windows, ':' elsewhere). Writes are always confined to the
# working directory and its subdirectories.
#DAVAI_RO_DIRS=C:\refs\specs;C:\refs\vendor-docs

# --- behaviour ---------------------------------------------------------------
# low | medium | high | xhigh | max
DAVAI_EFFORT=high

# Max tokens per response. Defaults to min(model max output, 32000).
#DAVAI_MAX_TOKENS=32000

# Sampling temperature. Unset means the provider default; current reasoning
# models reject it entirely, so leave it alone unless you know you need it.
#DAVAI_TEMPERATURE=

# Seconds before a shell op is killed.
DAVAI_SHELL_TIMEOUT=120

# Fraction of the context window at which auto-compaction kicks in.
DAVAI_COMPACT_AT=0.75

# Override the context window. Normally detected from the model.
#DAVAI_CONTEXT_LIMIT=

# Show the model's reasoning summary while it streams.
DAVAI_THINKING=false

# Run shell commands without asking for approval. Off unless you mean it: the write
# jail and read allowlist still hold, but nothing pauses before `rm -rf` either.
# `--yolo` does this for one run, `/yolo` toggles it inside a session.
DAVAI_YOLO=false

# --- network -----------------------------------------------------------------
#HTTP_PROXY=
#HTTPS_PROXY=
#NO_PROXY=
